// Copier en secrets_wifi.h (ignoré par git) et remplir : Wi-Fi et réseau local des écrans.
#pragma once

// Wi-Fi de la maison : le même SSID pour la box et le répéteur (l'écran retient la borne la plus forte).
#define WIFI_MAISON_SSID "mon_reseau"
#define WIFI_MAISON_MDP "a_remplir"
// Canal de la borne principale (scan ciblé si le scan complet ne trouve rien) ; 0 = toujours scan complet.
#define WIFI_MAISON_CANAL 6

// Réseau local : préfixe des adresses IPv4 (les écrans reçoivent une IP statique = préfixe +
// dernier octet de la table ECRANS[], src/ecran/ecran.cpp) et dernier octet de la passerelle.
#define RESEAU_OCTET_1 192
#define RESEAU_OCTET_2 168
#define RESEAU_OCTET_3 1
#define RESEAU_PASSERELLE 1
// Adresse du PC autorisé à piloter le banc HTTP de l'écran (port 8080, src/ecran/banc_distant.cpp).
#define RESEAU_PC 10
