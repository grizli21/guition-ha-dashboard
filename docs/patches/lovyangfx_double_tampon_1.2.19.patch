+  // 27/10/2026 (dashboard guition) : seconde mémoire d'image, même chaîne de descripteurs que la première (boucle sur
+  // elle-même) ; l'interruption VSYNC repart sur l'une ou l'autre
+  bool Bus_RGB::initDoubleBuffer(void)
+  {
+    if (_frame_buffer2) { return true; }
+    if (!_frame_buffer || !_fb_len) { return false; }
+    static constexpr size_t MAX_DMA_LEN = (4096-64);
+    size_t dmadesc_size = (_fb_len - 1) / MAX_DMA_LEN + 1;
+    auto data = (uint8_t*)heap_alloc_psram(_fb_len);
+    auto dmadesc = (dma_descriptor_t*)heap_caps_malloc(sizeof(dma_descriptor_t) * dmadesc_size, MALLOC_CAP_DMA);
+    if (!data || !dmadesc)
+    {
+      if (data) { heap_free(data); }
+      if (dmadesc) { heap_caps_free(dmadesc); }
+      return false;
+    }
+    memcpy(data, _frame_buffer, _fb_len);
+    esp_cache_msync(data, _fb_len, ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+    _dmadesc2 = dmadesc;
+    auto first = dmadesc;
+    auto p = data;
+    size_t len = _fb_len;
+    while (len > MAX_DMA_LEN)
+    {
+      len -= MAX_DMA_LEN;
+      dmadesc->buffer = p;
+      p += MAX_DMA_LEN;
+      *(uint32_t*)dmadesc = MAX_DMA_LEN | MAX_DMA_LEN << 12 | 0x80000000;
+      dmadesc->next = dmadesc + 1;
+      dmadesc++;
+    }
+    *(uint32_t*)dmadesc = ((len + 3) & ( ~3 )) | len << 12 | 0xC0000000;
+    dmadesc->buffer = p;
+    dmadesc->next = first;
+    memcpy(&_dmadesc_restart2, first, sizeof(_dmadesc_restart2));
+    _dmadesc_restart2.buffer = &data[_skip_bytes];
+    _dmadesc_restart2.dw0.length -= _skip_bytes;
+    _dmadesc_restart2.dw0.size -= _skip_bytes;
+    _frame_buffer2 = data; // en dernier : la chaîne est prête avant qu'on puisse la demander
+    return true;
+  }
+
   uint8_t* Bus_RGB::getDMABuffer(uint32_t length)
   {
     return _frame_buffer;
@@ -359,6 +410,11 @@ namespace lgfx
       heap_caps_free(_dmadesc);
       _dmadesc = nullptr;
     }
+    if (_dmadesc2)
+    {
+      heap_caps_free(_dmadesc2);
+      _dmadesc2 = nullptr;
+    }
   }
 
