     LV_PROFILER_REFR_BEGIN;
     LV_TRACE_REFR("begin");
 
+#if defined(ARDUINO)
+    uint32_t lv_pile_inv_avant = 0; /* zones sales de l'image : 0 = rien de dessine, pas de trace */
