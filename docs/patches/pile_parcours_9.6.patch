-void lv_obj_refr(lv_layer_t * layer, lv_obj_t * obj)
+static void lv_obj_refr_sonde(lv_layer_t * layer, lv_obj_t * obj)
 {
     LV_CHECK_ARG(layer != NULL, return);
     LV_CHECK_ARG(obj != NULL, return);
@@ -628,6 +659,21 @@
