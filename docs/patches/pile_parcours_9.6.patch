@@ -19,6 +19,22 @@
 #include "../lvgl_public.h"
 #include "lv_obj_style_internal.h"
 
+#if defined(ARDUINO)
+/* Mesure 06/11 — profondeur de dessin et marge de pile, page par page (OPTI_JOURNAL 06/11).
+ * Compteur de profondeur pose sur lv_obj_refr : en 9.6 c'est LA recursion du parcours d'objets
+ * (lv_obj_refr <-> lv_obj_redraw : lv_refr.c:182/211/232/254 -> 536 ; refr_obj_and_children,
+ * lv_refr.c:1119, n'est PAS recursive — appelee une fois par ecran/couche depuis refr_area).
+ * Une seule lecture de uxTaskGetStackHighWaterMark (octets, noyau FreeRTOS S3) par image, a la
+ * fin de lv_display_refr_timer ; une seule trace par image via lv_pile_trace (crochet applicatif).
+ * Versionne : simu/v9/pile_parcours_9.6.patch — ne jamais editer ce fichier a la main :
+ * simu/v9/applique_pile_ecran.sh [etat|appliquer|retirer]. */
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+static int lv_pile_prof = 0;
+static int lv_pile_prof_max = 0;
+extern void lv_pile_trace(int profondeur_max, int marge_pile_o);
+#endif
+
