 }
 
+/* Enveloppe du compteur : signature publique inchangee, appelee par tous les sites (lv_refr.c
+ * et lv_snapshot.c). Le compteur suit la recursion reelle : lv_obj_refr_sonde -> lv_obj_redraw
+ * -> wrapper lv_obj_refr pour chaque enfant. */
+void lv_obj_refr(lv_layer_t * layer, lv_obj_t * obj)
+{
+#if defined(ARDUINO)
+    lv_pile_prof++;
+    if(lv_pile_prof > lv_pile_prof_max) lv_pile_prof_max = lv_pile_prof;
+    lv_obj_refr_sonde(layer, obj);
+    lv_pile_prof--;
+#else
+    lv_obj_refr_sonde(layer, obj);
+#endif
+}
+
