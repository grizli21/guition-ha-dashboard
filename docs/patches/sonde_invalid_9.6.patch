 /*Display being refreshed*/
 #define disp_refr LV_GLOBAL_DEFAULT()->disp_refresh
 
+#ifdef SONDE_INVALIDATION
+/* Mesure 05/11, etape 0 migration 9.6 : jumeau exact du compteur SONDE_INVALIDATION de LVGL 8.4
